{
  "version": "1.1.0",
  "agent": "radamanto",
  "measurement_prohibited": true,
  "dlt_exclusive_events": [
    "Domain_Entity_Degraded",
    "Domain_Entity_Restored",
    "Domain_Entity_Deprecated",
    "System_Immunity_Certified"
  ],
  "rules": {
    "R4.1": "success_rate < success_rate_min → Domain_Entity_Degraded",
    "R4.2": "avg_duration_ms > latency_ms_p95_threshold (≥5 samples) → Domain_Entity_Degraded",
    "R4.3": "pending_redemption + structure_valid + consecutive_success_count >= redemption_success_count → Domain_Entity_Restored (solo Radamanto)",
    "R4.4": "recovery_attempts >= max_recovery_attempts → Domain_Entity_Deprecated"
  },
  "transitions": {
    "healthy": ["degraded"],
    "degraded": ["pending_redemption", "deprecated"],
    "pending_redemption": ["healthy", "deprecated"],
    "deprecated": []
  },
  "redemption_emitter": "radamanto-batch-only",
  "argos_may_not_emit": ["Domain_Entity_Restored", "Domain_Entity_Degraded", "Domain_Entity_Deprecated"]
}
