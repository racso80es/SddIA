{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddia.local/norms/sddia-installer-result.schema.json",
  "title": "sddia-installer envelope",
  "type": "object",
  "required": ["meta", "success", "exitCode", "message", "result"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "entityKind", "entityId"],
      "properties": {
        "schemaVersion": { "const": "2.0" },
        "entityKind": { "const": "tool" },
        "entityId": { "const": "sddia-installer" }
      }
    },
    "success": { "type": "boolean" },
    "exitCode": { "type": "integer" },
    "message": { "type": "string" },
    "durationMs": { "type": "integer" },
    "feedback": { "type": "array" },
    "result": { "type": "object" }
  }
}
