{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddia.local/capability-contracts/eda.event_manager.v1.schema.json",
  "title": "eda.event_manager",
  "description": "Contrato aditivo EventManager v1.0.0 — I/O capsule-json-io (request/response JSON stdin/stdout). Operaciones: publish_ecst, claim_pending, record_delivery, move_to_dlq, replay_dlq, append_trace, handshake_version.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "required": ["operation", "payload"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": [
            "publish_ecst",
            "claim_pending",
            "record_delivery",
            "move_to_dlq",
            "replay_dlq",
            "append_trace",
            "handshake_version"
          ]
        },
        "payload": {
          "type": "object",
          "description": "Payload polimórfico por operation (if-then)."
        },
        "meta": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "publish_ecst" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["event_id", "ecst"],
                "properties": {
                  "event_id": { "type": "string", "minLength": 1 },
                  "ecst": { "type": "object" },
                  "trace_id": { "type": "string" }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "claim_pending" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["lease_owner", "limit"],
                "properties": {
                  "lease_owner": { "type": "string", "minLength": 1 },
                  "limit": { "type": "integer", "minimum": 1 },
                  "lease_ttl_ms": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "record_delivery" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["event_id", "delivery_id", "status"],
                "properties": {
                  "event_id": { "type": "string", "minLength": 1 },
                  "delivery_id": { "type": "string", "minLength": 1 },
                  "status": { "type": "string", "enum": ["ack", "nack"] },
                  "attempt": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "move_to_dlq" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["event_id", "reason"],
                "properties": {
                  "event_id": { "type": "string", "minLength": 1 },
                  "reason": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "replay_dlq" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "event_id": { "type": "string", "minLength": 1 },
                  "all": { "type": "boolean" }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "append_trace" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["trace_id", "frame"],
                "properties": {
                  "trace_id": { "type": "string", "minLength": 1 },
                  "frame": { "type": "object" }
                },
                "additionalProperties": true
              }
            }
          }
        },
        {
          "if": { "properties": { "operation": { "const": "handshake_version" } } },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "required": ["requested_range"],
                "properties": {
                  "requested_range": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "response": {
      "type": "object",
      "required": ["success", "exitCode"],
      "properties": {
        "success": { "type": "boolean" },
        "exitCode": { "type": "integer" },
        "message": { "type": "string" },
        "result": {
          "description": "Carga de resultado por operación."
        },
        "meta": {
          "type": "object",
          "additionalProperties": true
        },
        "error": {
          "type": "object",
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  }
}
