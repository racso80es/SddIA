{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddia.local/capability-contracts/tracker.lifecycle.schema.json",
  "title": "tracker.lifecycle",
  "description": "cap.body de emit_v2 (linear-tracker-adapter): success, exitCode, message y result opcional. additionalProperties permitido.",
  "type": "object",
  "required": ["success", "exitCode"],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "exitCode": {
      "type": "integer"
    },
    "message": {
      "type": "string"
    },
    "result": {
      "description": "Carga de la operación vigente. Ausente en el fallo de emit_v2."
    },
    "meta": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string" },
        "entityKind": { "type": "string" },
        "entityId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
