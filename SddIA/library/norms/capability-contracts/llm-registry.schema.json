{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sddia.local/capability-contracts/llm-registry.schema.json",
  "title": "llm-registry",
  "type": "object",
  "required": ["registry_version", "oracles"],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "oracles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["adapter_ref", "status"],
        "properties": {
          "adapter_ref": {
            "type": "string",
            "pattern": "^(tool|skill):[a-z0-9-]+$"
          },
          "model": { "type": "string" },
          "affinity": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "timeout_ms": { "type": "integer", "minimum": 1000 },
          "fallback": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["active", "disabled"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
