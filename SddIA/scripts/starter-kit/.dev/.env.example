# Variables compartidas del workspace (bóveda global) — perfil producción
# Copiar a {repo}/.dev/.env — ver también {repo}/.dev/.env.example
# Secretos → .SddIA/.dev/.env (bóveda instancia; prevalece)

SDDIA_ENV=production
SDDIA_LAB_SIMULATE_IOTA=0
SDDIA_LAB_SIMULATE_GH_PR=0
PYTHONUTF8=1
SDDIA_IOTA_TIMEOUT_SECONDS=45

# --- Gemini AI Studio (tool gemini-http-infer) ---
# GEMINI_API_KEY=   # secreto → bóveda instancia .SddIA/.dev/.env
# SDDIA_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# SDDIA_GEMINI_HTTP_TIMEOUT_SECS=30
# SDDIA_GEMINI_MODEL=   # fallback; no slug eterno (catálogo Google rota)
# agy CLI: sesión interactiva previa; no sustituir con GEMINI_API_KEY

