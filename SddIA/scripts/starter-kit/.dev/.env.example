# Variables compartidas del workspace (bóveda global) — perfil producción
# Copiar a {repo}/.dev/.env — ver también {repo}/.dev/.env.example
# Secretos → .SddIA/.dev/.env (bóveda instancia; prevalece)

SDDIA_ENV=production
SDDIA_LAB_SIMULATE_IOTA=0
SDDIA_LAB_SIMULATE_GH_PR=0
PYTHONUTF8=1
SDDIA_IOTA_TIMEOUT_SECONDS=45

# --- Gemini AI Studio (tool gemini-http-infer) ---
# GEMINI_API_KEY=   # secreto → bóveda instancia .SddIA/.dev/.env
# SDDIA_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# SDDIA_GEMINI_HTTP_TIMEOUT_SECS=30
# SDDIA_GEMINI_MODEL=   # fallback; no slug eterno (catálogo Google rota)
# SDDIA_GEMINI_THINKING_LEVEL=   # high|medium|low; vacío = default del modelo
# agy CLI: sesión interactiva previa; no sustituir con GEMINI_API_KEY
# SDDIA_AGY_EFFORT=              # high|medium|low; vacío = handler Aiúa default high
# SDDIA_AGY_TIMEOUT_SECS=        # segundos; vacío = print_timeout 300s; no altera default 120 del bridge

# --- Registro de oráculos LLM (tool:llm-router) ---
# El registro elige oráculo. Familias SDDIA_GEMINI_* / SDDIA_AGY_* = credenciales/defaults del adaptador.
# Copia: SddIA/scripts/starter-kit/.SddIA/llm-registry.example.json → .SddIA/llm-registry.json
# SDDIA_LLM_REGISTRY_PATH=

# --- Tiers cognitivos de fases agent: (instancia) ---
# Vacío = fallback SDDIA_AGENT_RUNTIME_MODEL del harness de forja.
# El slug lo elige el operador el día que el proveedor lo acepte. No es contrato del Core.
# SDDIA_LLM_TIER_HIGH=
# SDDIA_LLM_TIER_MEDIUM=
# SDDIA_LLM_TIER_LOW=

