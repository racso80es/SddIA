# Bóveda instancia — prevalece sobre .dev/.env en la raíz del repo
# IOTA_WALLET_SECRET=
# IOTA_ANCHOR_PACKAGE_ID=
# SDDIA_LAB_SIMULATE_IOTA=0
# SDDIA_IOTA_TIMEOUT_SECONDS=45
#
# Persistencia física IOTA (SIMULATE=0):
# - SDDIA_LAB_MOCK_IOTA_URL debe quedar vacío (si se setea, precede al relay y no ancla on-chain)
# - IOTA_PUBLISH_RELAY_URL apunta al relay de instancia
# SDDIA_LAB_MOCK_IOTA_URL=
# IOTA_PUBLISH_RELAY_URL=http://127.0.0.1:8787/v1/publish
