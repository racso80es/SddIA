# Bóveda instancia SddIA_AP / consumidor — prevalece sobre .dev/.env en la raíz.
# SSOT inventario: docs/todos/pending/[LABORATORIO] MVP Paciente 0 SddIA_AP.md §4.2.2
# Cero secretos reales en este fichero. Copiar a .SddIA/.dev/.env y rellenar.

# --- Correo (obligatorio para circuito sensorial / email-watcher) ---
# Si SDDIA_EMAIL_IMAP_HOST falta: start-sddia.sh omite email-watcher con WARN.
# Con systemd (perfil Completo consumidor): completar antes de enable --now.
SDDIA_EMAIL_IMAP_HOST=
SDDIA_EMAIL_IMAP_PORT=993
SDDIA_EMAIL_IMAP_USER=
SDDIA_EMAIL_IMAP_SECRET=
SDDIA_EMAIL_MAILBOX=INBOX
SDDIA_EMAIL_POLL_SECONDS=60
SDDIA_EMAIL_SNIPPET_CHARS=512
SDDIA_EMAIL_INITIAL_LOOKBACK_DAYS=60
SDDIA_EMAIL_MAX_UIDS_PER_POLL=50

# --- LLM (recomendado: fase Clasificacion; sin él solo Triaje-C) ---
# Chat SSE / mayeuta-llm:
#   SDDIA_LLM_CLI_COMMAND=python3 SddIA/scripts/tools/kalma2-agent-runtime-cursor.py
# Inferencia:
#   SDDIA_LLM_INFER_COMMAND="/path/to/cursor-agent --print --mode ask --trust"
SDDIA_LLM_CLI_COMMAND=
# SDDIA_LLM_CHAT_COMMAND=
# SDDIA_LLM_INFER_COMMAND=
# SDDIA_LLM_REQUIRE_INFER=1
# SDDIA_LLM_SSE_TIMEOUT_SECS=120
# SDDIA_LLM_CLI_TIMEOUT_SECS=120

# --- Telegram (opcional: eferente actionable + telegram-watcher aferente) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_CHAT_ID=

# --- WUI Kalma2 ---
# SDDIA_CLIENT_PORT=8765

# --- Consumidor: NO configurar runtime de agentes de forja (Filtro C) ---
# Prohibido en SddIA_AP: SDDIA_AGENT_RUNTIME_COMMAND hacia Tekton / feature / PR-review.

# --- IOTA (fuera del Done del ensayo; opcional) ---
# IOTA_WALLET_SECRET=
# IOTA_ANCHOR_PACKAGE_ID=
# SDDIA_LAB_SIMULATE_IOTA=0
# SDDIA_IOTA_TIMEOUT_SECONDS=45
# SDDIA_LAB_MOCK_IOTA_URL=
# IOTA_PUBLISH_RELAY_URL=http://127.0.0.1:8787/v1/publish

# --- Gemini AI Studio (tool gemini-http-infer) ---
# Secreto táctico: copiar a .SddIA/.dev/.env, no al global.
# GEMINI_API_KEY=
# SDDIA_GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# SDDIA_GEMINI_HTTP_TIMEOUT_SECS=30
# Fallback si request.model vacío. Slug de catálogo cambia (2026-09-04: gemini-2.5-flash 404 new users).
# No es valor-ley: elegir un modelo que POST generateContent acepte ese día.
# SDDIA_GEMINI_MODEL=
# Skill antigravity-cli-executor: auth = sesión cacheada de `agy`, no esta key.

# --- Tiers cognitivos de fases agent: ---
# Solo si esta instancia despacha forja (no SddIA_AP / Filtro C).
# Vacío = fallback SDDIA_AGENT_RUNTIME_MODEL. Cero slug-ley.
# SDDIA_LLM_TIER_HIGH=
# SDDIA_LLM_TIER_MEDIUM=
# SDDIA_LLM_TIER_LOW=
