[Unit]
Description=SddIA email-watcher (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%f
EnvironmentFile=-%f/.SddIA/.dev/.env
ExecStart=%f/SddIA/daemons/email-watcher.sh
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
Restart=always
RestartSec=5
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
