[Unit]
Description=SddIA iota-publish-relay (%f)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%f
EnvironmentFile=-%f/.SddIA/.dev/.env
ExecCondition=%f/SddIA/scripts/daemons/_precondition.sh iota-publish-relay %f
ExecStart=%f/SddIA/scripts/daemons/iota-publish-relay.sh
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
StartLimitIntervalSec=300
StartLimitBurst=5
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2 78
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
