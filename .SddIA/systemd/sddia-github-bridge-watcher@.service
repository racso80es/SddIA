[Unit]
Description=SddIA github-bridge-watcher (%f)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%f
EnvironmentFile=-%f/.SddIA/.dev/.env
ExecStart=%f/SddIA/scripts/daemons/github-bridge-watcher.sh
LogRateLimitIntervalSec=30s
LogRateLimitBurst=500
Restart=always
RestartSec=5
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
