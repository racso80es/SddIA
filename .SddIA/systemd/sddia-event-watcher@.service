[Unit]
Description=SddIA event-watcher (%f)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%f
EnvironmentFile=-%f/.SddIA/.dev/.env
ExecStart=%f/SddIA/scripts/daemons/event-watcher.sh
Restart=always
RestartSec=5
KillMode=process
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target
