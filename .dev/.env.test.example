# Perfil laboratorio EDA — copiar a .dev/.env.test (gitignored si personalizado)
SDDIA_ENV=test

# Gate Rust del bus (mismo criterio que producción salvo tests que fijen filesystem en el comando)
SDDIA_EVENT_STORE=redb
SDDIA_EVENT_STORE_OPEN_BUDGET_MS=2000

# Aislamiento solo scripts Python (eda_bus_utils); no sustituye SDDIA_EVENT_STORE
EVENT_BUS_PATH=.tmp/events_test
SDDIA_LAB_SIMULATE_IOTA=1
SDDIA_LAB_SIMULATE_SYNC_INDEX=1

PYTHONUTF8=1
