# Bóveda global — plantilla perfil producción
# Copiar a .dev/.env en la raíz del workspace
# Secretos (IOTA_WALLET_SECRET, IOTA_ANCHOR_PACKAGE_ID) → .SddIA/.dev/.env

SDDIA_ENV=production

SDDIA_LAB_SIMULATE_IOTA=0
SDDIA_LAB_SIMULATE_GH_PR=0
SDDIA_LAB_SIMULATE_SYNC_INDEX=0

SDDIA_SKIP_HOOKS=0
SDDIA_LAB_SKIP_ACCEPT_PR_HANDOFF=0
SDDIA_LAB_SKIP_GIT_PUSH=0
SDDIA_LAB_SKIP_GIT_CHECKOUT=0
SDDIA_LAB_SKIP_SNAPSHOT=0
SDDIA_LAB_SKIP_HIGIENE=0

PYTHONUTF8=1
SDDIA_IOTA_TIMEOUT_SECONDS=45
