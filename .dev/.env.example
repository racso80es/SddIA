# Bóveda local SddIA — variables de instancia (no versionar .dev/.env con secretos)

# Comando CLI de inferencia LLM (Cursor u otro). Recibe prompt/JSON por stdin; responde por stdout.
# Chat SSE (mayeuta-llm STREAM): preferir el inyector Python dual-mode:
#   SDDIA_LLM_CLI_COMMAND=python3 SddIA/scripts/tools/kalma2-agent-runtime-cursor.py
#   SDDIA_LLM_CHAT_MOCK=1          # eco sin SQLite
# Inferencia (opcional; si falta → ack + persistencia SQLite):
#   SDDIA_LLM_INFER_COMMAND=cursor-agent --print
#   # o SDDIA_AGENT_RUNTIME_CLI=...  (no reusa el .py prótesis)
# SQLite Cursor (Foso Biológico):
#   SDDIA_CURSOR_VSCDB=~/.config/Cursor/User/globalStorage/state.vscdb
#   SDDIA_CURSOR_SQLITE_WRITE=1
#   SDDIA_CURSOR_WORKSPACE_ID=   # opcional; se infiere del repo
#   SDDIA_CURSOR_COMPOSER_ID=    # opcional; reutilizar conversación
SDDIA_LLM_CLI_COMMAND=
# SDDIA_LLM_CHAT_COMMAND=   # opcional; tiene precedencia sobre SDDIA_LLM_CLI_COMMAND en STREAM

# Timeout SSE / CLI LLM (segundos)
# SDDIA_LLM_SSE_TIMEOUT_SECS=120
# SDDIA_LLM_CLI_TIMEOUT_SECS=120

# Runtime de agentes V5 (kalma2-full-cycle). JSON AGENT_PHASE stdin → última línea JSON stdout.
# Producción (Cursor CLI / SDK):
#   SDDIA_AGENT_RUNTIME_COMMAND=SddIA/scripts/tools/kalma2-agent-runtime-cursor.sh
#   SDDIA_AGENT_RUNTIME_CLI='cursor-agent --print'   # opcional; fallback SDDIA_LLM_CLI_COMMAND
#   SDDIA_AGENT_RUNTIME_BACKEND=cli                  # o sdk (+ CURSOR_API_KEY + pip install cursor-sdk)
#   SDDIA_AGENT_RUNTIME_MODEL=composer-2.5
#   SDDIA_AGENT_RUNTIME_TIMEOUT_SECS=600
# Lab (solo handoff, sin Cursor):
#   SDDIA_AGENT_RUNTIME_COMMAND=SddIA/scripts/tools/kalma2-agent-runtime-lab.sh
# CI / mock:
#   SDDIA_AGENT_RUNTIME_MOCK=1
# SDDIA_AGENT_RUNTIME_COMMAND=SddIA/scripts/tools/kalma2-agent-runtime-cursor.sh
